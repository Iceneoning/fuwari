---
import { existsSync, readdirSync } from "node:fs";
import { resolve } from "node:path";
import { Icon } from "astro-icon/components";

const now = new Date();
const initialMonth = now.toLocaleDateString("zh-CN", { month: "long" });
const initialDay = String(now.getDate()).padStart(2, "0");
const initialYear = now.getFullYear();
const initialWeekday = now.toLocaleDateString("zh-CN", { weekday: "long" });
const initialHour = String(now.getHours()).padStart(2, "0");
const initialMinute = String(now.getMinutes()).padStart(2, "0");
const initialSecond = String(now.getSeconds()).padStart(2, "0");
const initialClock = `${initialHour}:${initialMinute}:${initialSecond}`;
const initialGreeting =
	now.getHours() < 6
		? "夜深了"
		: now.getHours() < 12
			? "早上好"
			: now.getHours() < 18
				? "下午好"
				: "晚上好";
const forecastDir = resolve("public", "DailyForecast", "optimized");
const forecastImages = existsSync(forecastDir)
	? readdirSync(forecastDir, { withFileTypes: true })
			.filter(
				(entry) =>
					entry.isFile() && /\.(avif|gif|jpe?g|png|webp)$/i.test(entry.name),
			)
			.map((entry) => entry.name)
			.sort((a, b) => a.localeCompare(b, "zh-CN", { numeric: true }))
	: [];
const forecastImageUrls = forecastImages.map(
	(image) => `/DailyForecast/optimized/${encodeURIComponent(image)}`,
);
---

<date-time-panel class="date-panel block" data-forecast-pool={JSON.stringify(forecastImageUrls)} aria-label="当前日期与时间">
	<div class="date-panel-card card-base relative overflow-hidden p-4">
		<div class="date-panel-glow" aria-hidden="true"></div>
		<div class="relative z-10">
		<div class="flex items-center justify-between">
			<div class="flex items-center gap-2 text-[0.68rem] font-bold tracking-[0.16em] text-black/40 dark:text-white/40">
				<span class="grid h-7 w-7 place-items-center rounded-lg bg-[var(--primary)]/10 text-[var(--primary)]">
					<Icon name="material-symbols:calendar-month-outline-rounded" class="text-base" />
				</span>
				此刻
			</div>
			<span class="live-dot" title="时间实时更新"><span></span> LIVE</span>
		</div>

		<div class="mt-4 flex items-stretch gap-3">
			<div class="calendar-page shrink-0 overflow-hidden rounded-xl">
				<div data-month class="calendar-month">{initialMonth}</div>
				<div data-day class="calendar-day">{initialDay}</div>
			</div>
			<div class="flex min-w-0 flex-1 flex-col justify-center">
				<div data-weekday class="text-lg font-bold text-black/80 dark:text-white/85">{initialWeekday}</div>
				<div data-year class="mt-0.5 text-xs font-semibold tracking-[0.12em] text-black/35 dark:text-white/35">{initialYear} · LOCAL TIME</div>
				<div data-greeting class="mt-2 truncate text-xs text-black/45 dark:text-white/45">{initialGreeting}</div>
			</div>
		</div>

		<div class="mt-4 flex items-end justify-between border-t border-black/[0.07] pt-3 dark:border-white/[0.08]">
			<div class="flex min-w-0 flex-col">
				<div data-clock class="clock-text flex items-center text-[1.72rem] font-extrabold leading-none text-black/85 tabular-nums dark:text-white/90">
					{initialClock}
				</div>
				<div class="mt-1 text-[0.62rem] font-bold tracking-[0.12em] text-black/30 dark:text-white/30">时 · 分 · 秒</div>
			</div>
			<div class="mb-0.5 grid h-9 w-9 place-items-center rounded-lg bg-black/[0.045] text-[var(--primary)] dark:bg-white/[0.06]">
				<Icon name="material-symbols:timer-outline-rounded" class="text-lg" />
			</div>
		</div>

		<div data-fortune class="fortune-panel mt-4 border-t border-black/[0.07] pt-3 dark:border-white/[0.08]">
			<div class="mb-2 flex items-center justify-between gap-2">
				<div class="flex items-center gap-2 text-[0.68rem] font-bold tracking-[0.12em] text-black/40 dark:text-white/40">
					<Icon name="material-symbols:auto-awesome-rounded" class="text-base text-[var(--primary)]" />
					今日运势
				</div>
				<span data-fortune-badge class="fortune-badge">未揭晓</span>
			</div>
			<button data-fortune-button type="button" class="fortune-button">
				<Icon name="material-symbols:flare-rounded" class="text-lg" />
				<span>查看今日运势</span>
			</button>
			<div data-fortune-result class="fortune-result" hidden>
				<div class="flex items-center justify-between gap-3">
					<div data-fortune-title class="fortune-title text-xl font-extrabold leading-none text-black/80 dark:text-white/90">待开启</div>
					<div data-fortune-stars class="fortune-stars" aria-label="今日运势星级">
						<span>☆</span><span>☆</span><span>☆</span><span>☆</span><span>☆</span>
					</div>
				</div>
				<p data-fortune-text class="fortune-text m-0 mt-2 text-xs leading-5 text-black/50 dark:text-white/50">
					点击按钮后，今日的风会给你一个答案。
				</p>
			</div>
		</div>
	</div>
	</div>
	{forecastImageUrls.length > 0 && (
		<figure data-forecast-card class="forecast-card" hidden>
			<img data-forecast-image src="" alt="今日运势配图" loading="lazy" decoding="async" />
		</figure>
	)}
</date-time-panel>

<script>
	type DailyFortuneRecord = {
		date: string;
		rawScore: number;
		image?: string;
		version: 1;
	};

	class DateTimePanel extends HTMLElement {
		private readonly storageKey = "fuwari:daily-fortune";
		private timerId?: number;
		private fortuneAnimationId?: number;
		private fortuneKey?: string;
		private fortuneRevealed = false;
		private forecastPool?: string[];
		private lastHour?: number;
		private desktopQuery?: MediaQueryList;
		private clockElement?: HTMLElement | null;
		private monthElement?: HTMLElement | null;
		private dayElement?: HTMLElement | null;
		private weekdayElement?: HTMLElement | null;
		private yearElement?: HTMLElement | null;
		private greetingElement?: HTMLElement | null;
		private handleViewportChange = (event: MediaQueryListEvent) => {
			if (event.matches && !document.hidden) this.startTimer();
			else this.stopTimer();
		};
		private handleVisibilityChange = () => {
			if (document.hidden) this.stopTimer();
			else if (this.desktopQuery?.matches) this.startTimer();
		};
		private handleFortuneClick = () => {
			this.revealFortune(new Date());
		};

		connectedCallback() {
			this.clockElement = this.querySelector("[data-clock]");
			this.monthElement = this.querySelector("[data-month]");
			this.dayElement = this.querySelector("[data-day]");
			this.weekdayElement = this.querySelector("[data-weekday]");
			this.yearElement = this.querySelector("[data-year]");
			this.greetingElement = this.querySelector("[data-greeting]");
			this.desktopQuery = window.matchMedia("(min-width: 1280px)");
			this.desktopQuery.addEventListener("change", this.handleViewportChange);
			document.addEventListener("visibilitychange", this.handleVisibilityChange);
			this.querySelector("[data-fortune-button]")?.addEventListener("click", this.handleFortuneClick);
			if (this.desktopQuery.matches && !document.hidden) this.startTimer();
		}

		disconnectedCallback() {
			this.desktopQuery?.removeEventListener("change", this.handleViewportChange);
			document.removeEventListener("visibilitychange", this.handleVisibilityChange);
			this.querySelector("[data-fortune-button]")?.removeEventListener("click", this.handleFortuneClick);
			this.stopTimer();
			this.clearFortuneAnimation();
		}

		private startTimer() {
			if (this.timerId !== undefined) return;
			this.updateDateTime();
			this.scheduleNextTick();
		}

		private scheduleNextTick() {
			const delay = 1000 - (Date.now() % 1000) + 20;
			this.timerId = window.setTimeout(() => {
				this.timerId = undefined;
				this.updateDateTime();
				if (this.desktopQuery?.matches && !document.hidden) this.scheduleNextTick();
			}, delay);
		}

		private stopTimer() {
			if (this.timerId === undefined) return;
			window.clearInterval(this.timerId);
			this.timerId = undefined;
		}

		updateDateTime() {
			const current = new Date();
			const hour = current.getHours();
			this.updateText(
				this.clockElement,
				`${String(hour).padStart(2, "0")}:${String(current.getMinutes()).padStart(2, "0")}:${String(current.getSeconds()).padStart(2, "0")}`,
			);

			const previousFortuneKey = this.fortuneKey;
			this.prepareFortune(current);
			if (this.fortuneKey !== previousFortuneKey) {
				this.updateText(this.monthElement, current.toLocaleDateString("zh-CN", { month: "long" }));
				this.updateText(this.dayElement, String(current.getDate()).padStart(2, "0"));
				this.updateText(this.weekdayElement, current.toLocaleDateString("zh-CN", { weekday: "long" }));
				this.updateText(this.yearElement, `${current.getFullYear()} · LOCAL TIME`);
			}
			if (this.lastHour !== hour) {
				this.lastHour = hour;
				this.updateText(
					this.greetingElement,
					hour < 6 ? "夜深了" : hour < 12 ? "早上好" : hour < 18 ? "下午好" : "晚上好",
				);
			}
		}

		private updateText(element: HTMLElement | null | undefined, value: string) {
			if (element && element.textContent !== value) element.textContent = value;
		}

		private clearFortuneAnimation() {
			if (this.fortuneAnimationId === undefined) return;
			window.clearTimeout(this.fortuneAnimationId);
			this.fortuneAnimationId = undefined;
		}

		private prepareFortune(date: Date) {
			const key = `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()}`;
			if (this.fortuneKey === key) return;
			this.fortuneKey = key;
			this.fortuneRevealed = false;
			this.clearFortuneAnimation();
			this.classList.toggle("fortune-rescued", false);
			this.classList.toggle("fortune-rescuing", false);

			const stored = this.readStoredFortune(key);
			if (stored) {
				this.showStoredFortune(stored);
				return;
			}

			this.resetFortune();
		}

		private revealFortune(date: Date) {
			this.prepareFortune(date);
			if (this.fortuneRevealed) return;
			this.fortuneRevealed = true;

			const button = this.querySelector("[data-fortune-button]");
			const result = this.querySelector("[data-fortune-result]");
			button?.setAttribute("hidden", "");
			result?.removeAttribute("hidden");

			const key = this.fortuneKey ?? `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()}`;
			const rawScore = this.getRandomInt(6);
			const image = this.pickForecastImage();
			const needsRescue = rawScore <= 1;
			const finalScore = needsRescue ? 5 : rawScore;
			this.writeStoredFortune({ date: key, rawScore, image, version: 1 });
			this.resetForecastImage();
			this.classList.toggle("fortune-drawing", false);
			this.classList.toggle("fortune-revealed", false);
			this.classList.toggle("fortune-rescued", false);
			this.classList.toggle("fortune-rescuing", false);
			this.setFortuneBusy(true);

			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				this.finishFortune(rawScore, needsRescue, image);
				return;
			}

			this.renderFortunePending();
			this.classList.add("fortune-drawing");
			this.fortuneAnimationId = window.setTimeout(() => {
				this.classList.remove("fortune-drawing");
				this.renderFortune(rawScore, needsRescue ? "低星预警" : "今日定格");
				if (!needsRescue) {
					this.classList.add("fortune-revealed");
					this.revealForecastImage(image);
					this.setFortuneBusy(false);
					this.fortuneAnimationId = undefined;
					return;
				}

				this.classList.add("fortune-rescuing");
				this.fortuneAnimationId = window.setTimeout(() => {
					this.renderFortune(finalScore, "反转成功");
					this.classList.remove("fortune-rescuing");
					this.classList.add("fortune-rescued", "fortune-revealed");
					this.revealForecastImage(image);
					this.setFortuneBusy(false);
					this.fortuneAnimationId = undefined;
				}, 1100);
			}, 850);
		}

		private finishFortune(rawScore: number, needsRescue: boolean, image?: string) {
			this.renderFortune(needsRescue ? 5 : rawScore, needsRescue ? "反转成功" : "今日定格");
			this.classList.toggle("fortune-rescued", needsRescue);
			this.revealForecastImage(image);
			this.setFortuneBusy(false);
		}

		private renderFortunePending() {
			const title = this.querySelector("[data-fortune-title]");
			const stars = this.querySelector("[data-fortune-stars]");
			const text = this.querySelector("[data-fortune-text]");
			const badgeElement = this.querySelector("[data-fortune-badge]");
			if (title) title.textContent = "星轨流转";
			if (text) text.textContent = "正在倾听今天的风，请稍候片刻……";
			if (badgeElement) badgeElement.textContent = "占卜中";
			if (stars) {
				stars.setAttribute("aria-label", "正在揭晓今日运势");
				stars.innerHTML = Array.from({ length: 5 }, () => '<span class="is-pending">✦</span>').join("");
			}
		}

		private setFortuneBusy(isBusy: boolean) {
			this.querySelector("[data-fortune]")?.setAttribute("aria-busy", String(isBusy));
		}

		private showStoredFortune(record: DailyFortuneRecord) {
			this.fortuneRevealed = true;
			this.clearFortuneAnimation();
			this.querySelector("[data-fortune-button]")?.setAttribute("hidden", "");
			this.querySelector("[data-fortune-result]")?.removeAttribute("hidden");

			const wasRescued = record.rawScore <= 1;
			this.classList.toggle("fortune-rescuing", false);
			this.classList.toggle("fortune-drawing", false);
			this.classList.toggle("fortune-revealed", false);
			this.classList.toggle("fortune-rescued", wasRescued);
			this.setFortuneBusy(false);
			this.renderFortune(wasRescued ? 5 : record.rawScore, wasRescued ? "反转成功" : "今日已抽");
			const image = record.image ?? this.pickForecastImage();
			if (image && image !== record.image) {
				this.writeStoredFortune({ ...record, image });
			}
			this.revealForecastImage(image);
		}

		private resetFortune() {
			this.classList.remove("fortune-drawing", "fortune-revealed", "fortune-rescuing", "fortune-rescued");
			this.setFortuneBusy(false);
			this.querySelector("[data-fortune-button]")?.removeAttribute("hidden");
			this.querySelector("[data-fortune-result]")?.setAttribute("hidden", "");

			const title = this.querySelector("[data-fortune-title]");
			const stars = this.querySelector("[data-fortune-stars]");
			const text = this.querySelector("[data-fortune-text]");
			const badgeElement = this.querySelector("[data-fortune-badge]");

			if (title) title.textContent = "待开启";
			if (text) text.textContent = "点击按钮后，今日的风会给你一个答案。";
			if (badgeElement) badgeElement.textContent = "未揭晓";
			if (stars) {
				stars.setAttribute("aria-label", "今日运势未揭晓");
				stars.innerHTML = "<span>☆</span><span>☆</span><span>☆</span><span>☆</span><span>☆</span>";
			}
			this.resetForecastImage();
		}

		private revealForecastImage(selected?: string) {
			const card = this.querySelector("[data-forecast-card]");
			const image = this.querySelector<HTMLImageElement>("[data-forecast-image]");
			if (!card || !image || !selected) return;

			image.src = selected;
			image.alt = `今日运势配图：${decodeURIComponent(selected.split("/").pop() ?? "")}`;
			card.removeAttribute("hidden");
		}

		private resetForecastImage() {
			const card = this.querySelector("[data-forecast-card]");
			const image = this.querySelector<HTMLImageElement>("[data-forecast-image]");
			card?.setAttribute("hidden", "");
			if (image) {
				image.removeAttribute("src");
				image.alt = "今日运势配图";
			}
		}

		private pickForecastImage() {
			const pool = this.getForecastPool();
			return pool.length > 0 ? pool[this.getRandomInt(pool.length)] : undefined;
		}

		private getForecastPool() {
			if (this.forecastPool) return this.forecastPool;
			try {
				const pool = JSON.parse(this.dataset.forecastPool ?? "[]");
				this.forecastPool = Array.isArray(pool) ? pool.filter((item): item is string => typeof item === "string") : [];
			} catch {
				this.forecastPool = [];
			}
			return this.forecastPool;
		}

		private getRandomInt(max: number) {
			if (max <= 0) return 0;
			if (window.crypto?.getRandomValues) {
				const values = new Uint32Array(1);
				window.crypto.getRandomValues(values);
				return values[0] % max;
			}
			return Math.floor(Math.random() * max);
		}

		private readStoredFortune(dateKey: string): DailyFortuneRecord | null {
			try {
				const raw = window.localStorage.getItem(this.storageKey);
				if (!raw) return null;
				const record = JSON.parse(raw) as Partial<DailyFortuneRecord>;
				if (record.date !== dateKey) {
					window.localStorage.removeItem(this.storageKey);
					return null;
				}
				if (record.version !== 1 || typeof record.rawScore !== "number" || record.rawScore < 0 || record.rawScore > 5) return null;
				if (record.image !== undefined && typeof record.image !== "string") return null;
				const image = record.image && this.getForecastPool().includes(record.image) ? record.image : undefined;
				return {
					date: dateKey,
					rawScore: Math.trunc(record.rawScore),
					image,
					version: 1,
				};
			} catch {
				return null;
			}
		}

		private writeStoredFortune(record: DailyFortuneRecord) {
			try {
				window.localStorage.setItem(this.storageKey, JSON.stringify(record));
			} catch {
				// If localStorage is blocked, the draw still works for the current page view.
			}
		}

		private renderFortune(score: number, badge: string) {
			const titles = ["大凶", "小凶", "平", "小吉", "中吉", "大吉"];
			const texts = [
				"云层低垂，先别急着硬冲。给自己一杯热茶和一点耐心，运势正在改写。",
				"小有波折，但不必泄气。慢一点、稳一点，好消息已经在路上拐弯。",
				"今日平稳，适合整理计划。把手边的小事做好，心气会慢慢顺起来。",
				"微光入窗，适合推进想做的事。先迈出一步，后面的路会自己亮起来。",
				"顺风已至，适合表达、学习与行动。认真把握当下，会收获不错的回响。",
				"吉运自来，能享盛名，把握机会，必获成功。人生路上机会众多，只要把握好一次机会，将会改写您的人生。",
			];

			const title = this.querySelector("[data-fortune-title]");
			const stars = this.querySelector("[data-fortune-stars]");
			const text = this.querySelector("[data-fortune-text]");
			const badgeElement = this.querySelector("[data-fortune-badge]");

			if (title) title.textContent = titles[score];
			if (text) text.textContent = texts[score];
			if (badgeElement) badgeElement.textContent = badge;
			if (stars) {
				stars.setAttribute("aria-label", `今日运势 ${score} 星`);
				stars.innerHTML = Array.from({ length: 5 }, (_, index) => `<span class="${index < score ? "is-on" : ""}">${index < score ? "★" : "☆"}</span>`).join("");
			}
		}
	}

	if (!customElements.get("date-time-panel")) {
		customElements.define("date-time-panel", DateTimePanel);
	}
</script>

<style>
	.date-panel-card {
		isolation: isolate;
		border: 1px solid rgb(255 255 255 / 0.28);
		border-radius: var(--radius-large);
		box-shadow: 0 0.8rem 2.2rem rgb(29 35 58 / 0.08);
	}

	.date-panel [hidden] {
		display: none !important;
	}

	.date-panel-card::after {
		position: absolute;
		inset: 0;
		z-index: 0;
		background: linear-gradient(145deg, rgb(255 255 255 / 0.18), transparent 52%);
		content: "";
		pointer-events: none;
	}

	.date-panel-glow {
		position: absolute;
		top: -4.5rem;
		right: -4rem;
		width: 10rem;
		height: 10rem;
		border-radius: 9999px;
		background: color-mix(in oklch, var(--primary) 20%, transparent);
		pointer-events: none;
	}

	.live-dot {
		display: inline-flex;
		align-items: center;
		gap: 0.32rem;
		font-size: 0.58rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: rgb(0 0 0 / 0.28);
	}

	:global(.dark) .live-dot {
		color: rgb(255 255 255 / 0.3);
	}

	.live-dot span {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 9999px;
		background: oklch(0.72 0.18 150);
		box-shadow: 0 0 0 0.2rem oklch(0.72 0.18 150 / 0.13);
	}

	.calendar-page {
		width: 4rem;
		border: 1px solid rgb(0 0 0 / 0.06);
		background: rgb(255 255 255 / 0.5);
		box-shadow: 0 0.55rem 1.2rem rgb(31 38 63 / 0.07);
		text-align: center;
	}

	:global(.dark) .calendar-page {
		border-color: rgb(255 255 255 / 0.08);
		background: rgb(255 255 255 / 0.055);
	}

	.calendar-month {
		padding: 0.25rem 0.2rem;
		background: var(--primary);
		color: white;
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.08em;
	}

	.calendar-day {
		padding: 0.28rem 0 0.36rem;
		font-size: 1.75rem;
		font-weight: 850;
		line-height: 1;
		color: rgb(0 0 0 / 0.75);
		font-variant-numeric: tabular-nums;
	}

	:global(.dark) .calendar-day {
		color: rgb(255 255 255 / 0.84);
	}

	.time-colon {
		margin: 0 0.12em;
		color: var(--primary);
		animation: soft-blink 2s ease-in-out infinite;
	}

	.clock-text {
		letter-spacing: 0;
		white-space: nowrap;
	}

	.fortune-panel {
		position: relative;
		isolation: isolate;
	}

